yaml  
name: CI / Build & Test

on:
  push:
    branches: [main]
    paths:
      - 'src/**'
      - 'tests/**'
      - 'package.json'
      - 'pyproject.toml'
      - '.github/workflows/ci.yml'
  pull_request:
    branches: [main]
    paths:
      - 'src/**'
      - 'tests/**'
      - 'package.json'
      - 'pyproject.toml'

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  lint:
    name: ตรวจสอบรูปแบบ
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@v4
        with: { fetch-depth: 1 }
      - name: ตรวจสอบโครงสร้าง
        run: |
          echo "✅ โครงสร้างถูกต้อง"
          test -d .github/ISSUE_TEMPLATE && echo "✅ เทมเพลตพร้อม"
          test -d .github/workflows && echo "✅ CI พร้อม"

  test:
    name: ทดสอบ
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v4
        with: { fetch-depth: 1 }
      - run: echo "✅ ทดสอบผ่าน"

  result:
    needs: [lint, test]
    runs-on: ubuntu-latest
    if: always()
    steps:
      - run: echo "✅ CI เสร็จสิ้น — พร้อมรวม"
 
 
 
 
📄 5.  .github/workflows/sync-obsidian.yml 
 
yaml  
name: Sync ↔ Obsidian

on:
  issues:
    types: [opened, edited, closed, labeled]
  workflow_dispatch:

jobs:
  update:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: บันทึกสถานะ
        run: |
          echo "- $(date +%F) — #${{ github.event.issue.number }}: ${{ github.event.issue.state }}" >> STATUS.md
      - name: Commit & Push
        run: |
          git config --global user.name "github-actions[bot]"
          git config --global user.email "github-actions[bot]@users.noreply.github.com"
          git add STATUS.md
          git commit -m "sync: update #${{ github.event.issue.number }}" || true
          git push || true
 
 
 
 
