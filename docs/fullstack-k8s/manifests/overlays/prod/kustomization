<div>Production Kustomization Manifest (fullstack-k8s/manifests/overlays/prod/kustomization.yaml)</div>
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
metadata:
  name: fullstack-prod-overlay
namespace: fullstack-app

resources:
  - ../../base

patches:
  - path: patches/replica-count.yaml
  - path: patches/resource-limits.yaml
  - path: patches/env-config.yaml
    
